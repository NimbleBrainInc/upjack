{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research Report",
  "description": "A synthesized report combining notes and sources on a topic",
  "allOf": [
    { "$ref": "https://upjack.dev/schemas/v1/upjack-entity.schema.json" }
  ],
  "properties": {
    "title": {
      "type": "string",
      "description": "Report title"
    },
    "executive_summary": {
      "type": "string",
      "description": "2-3 sentence executive summary"
    },
    "body": {
      "type": "string",
      "description": "Full report body (Markdown)"
    },
    "methodology": {
      "type": "string",
      "description": "Research methodology used"
    },
    "open_questions": {
      "type": "array",
      "description": "Unresolved questions for further research",
      "items": {
        "type": "string"
      }
    },
    "source_count": {
      "type": "integer",
      "description": "Number of sources referenced",
      "minimum": 0
    },
    "note_count": {
      "type": "integer",
      "description": "Number of notes synthesized",
      "minimum": 0
    }
  },
  "required": ["title", "body"]
}
