{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research Source",
  "description": "A source of information (article, paper, report, etc.)",
  "allOf": [
    { "$ref": "https://upjack.dev/schemas/v1/upjack-entity.schema.json" }
  ],
  "properties": {
    "title": {
      "type": "string",
      "description": "Source title"
    },
    "url": {
      "type": "string",
      "description": "Source URL",
      "format": "uri"
    },
    "author": {
      "type": "string",
      "description": "Author or organization"
    },
    "published_at": {
      "type": "string",
      "description": "Publication date",
      "format": "date"
    },
    "source_type": {
      "type": "string",
      "description": "Type of source",
      "enum": ["journal", "article", "whitepaper", "blog", "report", "book", "video", "podcast", "social", "other"]
    },
    "credibility": {
      "type": "integer",
      "description": "Credibility rating (1-5)",
      "minimum": 1,
      "maximum": 5
    },
    "bias_notes": {
      "type": "string",
      "description": "Notes on potential bias or conflicts of interest"
    },
    "summary": {
      "type": "string",
      "description": "Brief summary of the source content"
    }
  },
  "required": ["title"]
}
