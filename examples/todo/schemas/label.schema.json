{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Todo Label",
  "description": "A label for categorizing tasks across projects",
  "allOf": [
    { "$ref": "https://upjack.dev/schemas/v1/upjack-entity.schema.json" }
  ],
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 64,
      "description": "Label name"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$",
      "description": "Hex color code for visual identification"
    },
    "description": {
      "type": "string",
      "description": "What this label represents"
    }
  },
  "required": ["name"]
}
